@model CommunitySportsFacilitiesBookingSystem.Models.Facility

@{
    ViewBag.Title = "Facility Details";
    bool isMember = Session["MemberID"] != null;
}

<div class="container">
    <div class="page-header">
        <h2>@Model.FacilityName</h2>
        <p>@Model.Description</p>
    </div>

    <dl class="dl-horizontal">
        <dt>Facility type</dt>
        <dd>@Model.FacilityType.TypeName</dd>

        <dt>Location</dt>
        <dd>@Model.City</dd>

        <dt>Sports</dt>
        <dd>
            @if (Model.FacilitySports.Any())
            {
                @String.Join(", ", Model.FacilitySports.Select(fs => fs.Sport.SportName))
            }
            else
            {
                <span>Not specified</span>
            }
        </dd>

        @if (isMember)
        {
            <dt>Address</dt>
            <dd>@Model.AddressLine, @Model.City @Model.PostalCode</dd>

            <dt>Capacity</dt>
            <dd>@Model.Capacity participants</dd>

            <dt>Hourly rate</dt>
            <dd>@Model.HourlyRate.ToString("N2")</dd>

            <dt>Contact phone</dt>
            <dd>@(String.IsNullOrWhiteSpace(Model.ContactPhone) ? "Not provided" : Model.ContactPhone)</dd>

            <dt>Opening hours</dt>
            <dd>
                @if (Model.FacilitySchedules.Any(s => s.IsAvailable))
                {
                    foreach (var schedule in Model.FacilitySchedules.Where(s => s.IsAvailable).OrderBy(s => s.DayOfWeek))
                    {
                        string dayName = schedule.DayOfWeek == 7
                            ? "Sunday"
                            : ((DayOfWeek)schedule.DayOfWeek).ToString();
                        <div>@dayName: @schedule.OpeningTime.ToString(@"hh\:mm") - @schedule.ClosingTime.ToString(@"hh\:mm")</div>
                    }
                }
                else
                {
                    <span>No available schedule has been published.</span>
                }
            </dd>
        }
    </dl>

    @if (isMember)
    {
        @Html.ActionLink("Book This Facility", "Create", "Bookings",
            new { facilityId = Model.FacilityID }, new { @class = "btn btn-success" })
    }
    else
    {
        <div class="alert alert-info">
            Sign in to view booking details, exact availability and pricing.
        </div>
        @Html.ActionLink("Sign In to Book", "Login", "Account", null,
            new { @class = "btn btn-primary" })
    }

    @Html.ActionLink("Back to Facilities", "Index", null, new { @class = "btn btn-default" })
</div>
