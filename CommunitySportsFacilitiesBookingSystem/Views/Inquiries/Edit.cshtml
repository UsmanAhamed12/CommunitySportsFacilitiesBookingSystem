@model CommunitySportsFacilitiesBookingSystem.Models.Inquiry
@{ ViewBag.Title = "Manage inquiry"; }
<section class="surface"><div class="eyebrow">Council inbox</div><h2>@Model.InquirySubject</h2><p>From @Model.SenderName &middot; @Model.SenderEmail &middot; @Model.SubmittedAt.ToString("dd MMM yyyy")</p><blockquote>@Model.InquiryMessage</blockquote>
@using (Html.BeginForm()) {
 @Html.AntiForgeryToken() @Html.HiddenFor(m => m.InquiryID) @Html.ValidationSummary(false, "", new { @class = "text-danger" })
 <div class="form-group"><label for="InquiryStatus">Status</label>@Html.DropDownListFor(m => m.InquiryStatus, new[] { new SelectListItem { Value = "New", Text = "New" }, new SelectListItem { Value = "InProgress", Text = "In progress" }, new SelectListItem { Value = "Resolved", Text = "Resolved" }, new SelectListItem { Value = "Closed", Text = "Closed" } }, new { @class = "form-control" })</div>
 <div class="form-group"><label for="ResponseMessage">Response record</label>@Html.TextAreaFor(m => m.ResponseMessage, new { @class = "form-control", rows = 5, maxlength = 1000 })<p class="help-block">Record your response after contacting the member. Saving does not send an email.</p></div>
 <button type="submit" class="btn btn-primary">Save inquiry</button> <a class="btn btn-default" href="@Url.Action("Index")">Back to inbox</a>
}
</section>
