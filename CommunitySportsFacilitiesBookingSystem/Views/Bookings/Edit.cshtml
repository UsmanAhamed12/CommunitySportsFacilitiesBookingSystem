@model CommunitySportsFacilitiesBookingSystem.Models.Booking
@{ ViewBag.Title = "Manage booking"; }
<div class="page-header"><div class="eyebrow">Council administration</div><h2>Manage booking #@Model.BookingID</h2><p>@Model.Facility.FacilityName &middot; @Model.BookingDate.ToString("dd MMM yyyy") &middot; @Model.StartTime.ToString(@"hh\:mm") &ndash; @Model.EndTime.ToString(@"hh\:mm")</p></div>
<section class="surface">
<p>Member: <strong>@Model.Member.FirstName @Model.Member.LastName</strong> &middot; Total: <strong>LKR @Model.TotalAmount.ToString("N2")</strong></p>
<p>Current status: <span class="label label-info">@Model.BookingStatus</span></p>
@using (Html.BeginForm()) {
    @Html.AntiForgeryToken() @Html.HiddenFor(m => m.BookingID)
    @Html.ValidationSummary(false, "", new { @class = "text-danger" })
    <div class="form-group"><label for="BookingStatus">Update status</label>@Html.DropDownListFor(m => m.BookingStatus, new SelectList(new[] { "Pending", "Confirmed", "Completed", "Cancelled", "Rejected" }, Model.BookingStatus), new { @class = "form-control" })</div>
    <p class="help-block">Confirm or reject pending requests. Complete confirmed bookings after their session ends. Cancelled, rejected and completed bookings remain in the history.</p>
    <button class="btn btn-primary" type="submit">Save status</button> <a class="btn btn-default" href="@Url.Action("Index")">Back to bookings</a>
}
</section>
