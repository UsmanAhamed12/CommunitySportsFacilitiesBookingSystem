@model CommunitySportsFacilitiesBookingSystem.ViewModels.BookingCreateViewModel

@{
    ViewBag.Title = "Book Facility";
}

<div class="container">
    <div class="row">
        <div class="col-md-7 col-md-offset-2">
            <h2>Book a Sports Facility</h2>

            <div class="alert alert-info">
                <strong>Selected facility:</strong>
                @Model.FacilityName
            </div>

            @using (Html.BeginForm())
            {
                @Html.AntiForgeryToken()
                @Html.HiddenFor(m => m.FacilityID)
                @Html.HiddenFor(m => m.FacilityName)

                @Html.ValidationSummary(
                    true,
                    "",
                    new { @class = "text-danger" })

                <div class="form-group">
                    @Html.LabelFor(m => m.BookingDate)
                    @Html.TextBoxFor(
                        m => m.BookingDate,
                        "{0:yyyy-MM-dd}",
                        new
                        {
                            @class = "form-control",
                            type = "date"
                        })
                    @Html.ValidationMessageFor(
                        m => m.BookingDate,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.StartTime)
                    @Html.TextBoxFor(
                        m => m.StartTime,
                        "{0:hh\\:mm}",
                        new
                        {
                            @class = "form-control",
                            type = "time"
                        })
                    @Html.ValidationMessageFor(
                        m => m.StartTime,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.EndTime)
                    @Html.TextBoxFor(
                        m => m.EndTime,
                        "{0:hh\\:mm}",
                        new
                        {
                            @class = "form-control",
                            type = "time"
                        })
                    @Html.ValidationMessageFor(
                        m => m.EndTime,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.NumberOfParticipants)
                    @Html.TextBoxFor(
                        m => m.NumberOfParticipants,
                        new
                        {
                            @class = "form-control",
                            type = "number",
                            min = "1"
                        })
                    @Html.ValidationMessageFor(
                        m => m.NumberOfParticipants,
                        "",
                        new { @class = "text-danger" })
                </div>

                <div class="form-group">
                    @Html.LabelFor(m => m.Purpose)
                    @Html.TextAreaFor(
                        m => m.Purpose,
                        new
                        {
                            @class = "form-control",
                            rows = "3",
                            placeholder = "Optional booking purpose"
                        })
                </div>

                <button type="submit" class="btn btn-success">
                    Confirm Booking
                </button>

                @Html.ActionLink(
                    "Back to Facilities",
                    "Index",
                    "Facilities",
                    null,
                    new { @class = "btn btn-default" })
            }
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
}