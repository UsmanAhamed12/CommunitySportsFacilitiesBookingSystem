@model CommunitySportsFacilitiesBookingSystem.Models.Booking
@{ ViewBag.Title = "Booking #" + Model.BookingID; }
<div class="page-header"><div class="eyebrow">Your reservation</div><h2>@Model.Facility.FacilityName</h2><p>Booking #@Model.BookingID &middot; Requested @Model.CreatedAt.ToString("dd MMM yyyy")</p></div>
<section class="surface"><span class="label @(Model.BookingStatus == "Pending" ? "label-warning" : "label-info")">@Model.BookingStatus</span><h3>@Model.BookingDate.ToString("dddd, dd MMM yyyy")</h3><p class="lead">@Model.StartTime.ToString(@"hh\:mm") &ndash; @Model.EndTime.ToString(@"hh\:mm")</p><dl class="dl-horizontal"><dt>Participants</dt><dd>@Model.NumberOfParticipants</dd><dt>Location</dt><dd>@Model.Facility.AddressLine, @Model.Facility.City</dd><dt>Session cost</dt><dd><strong>LKR @Model.TotalAmount.ToString("N2")</strong></dd><dt>Purpose</dt><dd>@(String.IsNullOrWhiteSpace(Model.Purpose) ? "Not specified" : Model.Purpose)</dd></dl>
@if (Model.BookingStatus == "Pending") { <p class="alert alert-info">The council is reviewing your request. Check My bookings for confirmation.</p> }
<a class="btn btn-default" href="@Url.Action("MyBookings")">Back to my bookings</a>
@if (Convert.ToString(Session["UserRole"]) == "Admin") { <a class="btn btn-primary" href="@Url.Action("Edit", new { id = Model.BookingID })">Manage status</a> }
</section>
