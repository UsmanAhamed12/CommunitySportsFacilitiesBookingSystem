@model IEnumerable<CommunitySportsFacilitiesBookingSystem.Models.Booking>
@{ ViewBag.Title = "Manage bookings"; }
<div class="page-header"><div class="eyebrow">Council administration</div><h2>Booking requests</h2><p>Confirm upcoming games and keep members informed.</p></div>
<p><a href="@Url.Action("Dashboard", "Home")">&larr; Dashboard</a></p>
@if (!Model.Any()) { <div class="empty-state"><h3>No bookings yet.</h3><p>Member requests will appear here.</p></div> }
else {
<div class="table-responsive"><table class="table"><thead><tr><th>Booking</th><th>Member</th><th>Session</th><th>Status</th><th>Total</th><th>Action</th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td><strong>@item.Facility.FacilityName</strong><br /><small>#@item.BookingID &middot; @item.NumberOfParticipants people</small></td><td>@item.Member.FirstName @item.Member.LastName</td><td>@item.BookingDate.ToString("dd MMM yyyy")<br />@item.StartTime.ToString(@"hh\:mm") &ndash; @item.EndTime.ToString(@"hh\:mm")</td><td><span class="label @(item.BookingStatus == "Pending" ? "label-warning" : "label-info")">@item.BookingStatus</span></td><td>LKR @item.TotalAmount.ToString("N2")</td><td><a class="btn btn-default btn-xs" href="@Url.Action("Edit", new { id = item.BookingID })">Manage</a></td></tr> }
</tbody></table></div>
}
