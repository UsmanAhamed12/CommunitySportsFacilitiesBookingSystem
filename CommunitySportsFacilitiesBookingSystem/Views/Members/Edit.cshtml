@model CommunitySportsFacilitiesBookingSystem.Models.Member
@{ ViewBag.Title = "Member access"; }
<section class="surface"><div class="eyebrow">Council administration</div><h2>@Model.FirstName @Model.LastName</h2><p>@Model.Email &middot; @Model.UserRole</p><p>Registered @Model.RegisteredAt.ToString("dd MMM yyyy"). Account history and credentials are retained when access is disabled.</p>
@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.MemberID) @Html.ValidationSummary(false, "", new { @class = "text-danger" })<div class="form-group"><label>@Html.CheckBoxFor(m => m.IsActive) Account is active</label></div><button class="btn btn-primary" type="submit">Save access</button> <a class="btn btn-default" href="@Url.Action("Index")">Back to members</a> }
</section>
