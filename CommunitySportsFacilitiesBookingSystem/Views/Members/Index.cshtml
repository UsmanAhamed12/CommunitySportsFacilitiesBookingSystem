@model IEnumerable<CommunitySportsFacilitiesBookingSystem.Models.Member>
@{ ViewBag.Title = "Members"; }
<div class="page-header"><div class="eyebrow">Council administration</div><h2>Community members</h2><p>Manage membership access while keeping each member's history intact.</p></div><p><a href="@Url.Action("Dashboard", "Home")">&larr; Dashboard</a></p>
<table class="table"><thead><tr><th>Member</th><th>Email</th><th>City</th><th>Role</th><th>Access</th><th></th></tr></thead><tbody>
@foreach (var item in Model) { <tr><td>@item.FirstName @item.LastName</td><td>@item.Email</td><td>@item.City</td><td>@item.UserRole</td><td>@(item.IsActive ? "Active" : "Inactive")</td><td><a class="btn btn-default btn-xs" href="@Url.Action("Edit", new { id = item.MemberID })">Manage access</a></td></tr> }
</tbody></table>
