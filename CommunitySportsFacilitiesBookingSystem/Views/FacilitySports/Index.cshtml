@model IEnumerable<CommunitySportsFacilitiesBookingSystem.Models.FacilitySport>

@{
    ViewBag.Title = "Index";
}

<h2>Index</h2>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.IsPrimarySport)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.AddedAt)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Facility.FacilityName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Sport.SportName)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.IsPrimarySport)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.AddedAt)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Facility.FacilityName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Sport.SportName)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.FacilitySportID }) |
            @Html.ActionLink("Details", "Details", new { id=item.FacilitySportID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.FacilitySportID })
        </td>
    </tr>
}

</table>
