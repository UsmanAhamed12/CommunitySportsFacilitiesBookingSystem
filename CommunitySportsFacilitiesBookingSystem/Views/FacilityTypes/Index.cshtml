@model IEnumerable<CommunitySportsFacilitiesBookingSystem.Models.FacilityType>

@{
    ViewBag.Title = "Facility types";
}

<div class="page-header"><div class="eyebrow">Council administration</div><h2>Facility types</h2></div><p><a href="@Url.Action("Dashboard", "Home")">&larr; Dashboard</a></p>

<p>
    @Html.ActionLink("Create New", "Create")
</p>
<table class="table">
    <tr>
        <th>
            @Html.DisplayNameFor(model => model.TypeName)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.Description)
        </th>
        <th>
            @Html.DisplayNameFor(model => model.IsActive)
        </th>
        <th></th>
    </tr>

@foreach (var item in Model) {
    <tr>
        <td>
            @Html.DisplayFor(modelItem => item.TypeName)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.Description)
        </td>
        <td>
            @Html.DisplayFor(modelItem => item.IsActive)
        </td>
        <td>
            @Html.ActionLink("Edit", "Edit", new { id=item.FacilityTypeID }) |
            @Html.ActionLink("Details", "Details", new { id=item.FacilityTypeID }) |
            @Html.ActionLink("Delete", "Delete", new { id=item.FacilityTypeID })
        </td>
    </tr>
}

</table>
