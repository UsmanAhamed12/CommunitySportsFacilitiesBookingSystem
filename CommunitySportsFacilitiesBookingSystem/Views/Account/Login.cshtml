@model CommunitySportsFacilitiesBookingSystem.ViewModels.LoginViewModel
@{ ViewBag.Title = "Welcome back"; }
<section class="auth-card">
    <div class="eyebrow">Your next game is waiting</div>
    <h1>Welcome back.</h1><p>Sign in to book a space and keep track of your games.</p>
    @using (Html.BeginForm()) {
        @Html.AntiForgeryToken()
        @Html.Hidden("returnUrl", (string)ViewBag.ReturnUrl)
        @Html.ValidationSummary(true, "", new { @class = "text-danger", role = "alert" })
        <div class="form-group">@Html.LabelFor(m => m.Email)@Html.TextBoxFor(m => m.Email, new { @class = "form-control", type = "email", autocomplete = "username", placeholder = "you@example.com" })@Html.ValidationMessageFor(m => m.Email, "", new { @class = "text-danger" })</div>
        <div class="form-group">@Html.LabelFor(m => m.Password)@Html.PasswordFor(m => m.Password, new { @class = "form-control", autocomplete = "current-password" })@Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger" })</div>
        <button type="submit" class="btn btn-primary btn-block">Sign in &rarr;</button>
    }
    <p style="margin-top:24px">New here? <a href="@Url.Action("Register", "Account")">Create your membership</a></p>
</section>
@section Scripts { @Scripts.Render("~/bundles/jqueryval") }
