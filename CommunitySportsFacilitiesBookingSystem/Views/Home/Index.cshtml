@{ ViewBag.Title = "Find your next game"; }
<section class="hero">
    <div class="hero-copy">
        <div class="eyebrow">Your neighbourhood. Your playground.</div>
        <h1>Make time<br />for <em>play.</em></h1>
        <p>A friendly match. A new routine. A little more time outdoors. Find a community sports space and make it happen.</p>
        <div class="hero-actions">
            <a class="btn btn-primary btn-lg" href="@Url.Action("Index", "Facilities")">Explore facilities &rarr;</a>
            @if (Session["MemberID"] == null) { <a class="btn btn-default btn-lg" href="@Url.Action("Register", "Account")">Join the community</a> }
            else { <a class="btn btn-default btn-lg" href="@Url.Action("MyBookings", "Bookings")">My bookings</a> }
        </div>
        <p class="hero-note">Local spaces &nbsp;&middot;&nbsp; Simple reservations &nbsp;&middot;&nbsp; More time playing</p>
    </div>
    <div class="hero-media" role="img" aria-label="Community sports facilities">
        <div class="hero-caption">Good games start close to home.<small>Courts, playing fields and indoor sports spaces.</small></div>
    </div>
</section>
<div class="section-heading"><div><div class="eyebrow">Less planning. More playing.</div><h2>Your next game, in three steps.</h2><p>Everything you need to get your community moving.</p></div></div>
<section class="feature-grid" aria-label="How booking works">
    <article class="feature-card"><span class="feature-number">01</span><h3>Find your space</h3><p>Explore local courts, fields and halls. Filter by your sport and city to find the right fit.</p><a href="@Url.Action("Index", "Facilities")">Browse facilities &rarr;</a></article>
    <article class="feature-card"><span class="feature-number">02</span><h3>Pick your time</h3><p>Sign in to check opening hours, choose an available slot and review the cost before requesting a booking.</p><a href="@Url.Action("MyBookings", "Bookings")">Manage bookings &rarr;</a></article>
    <article class="feature-card"><span class="feature-number">03</span><h3>Show up. Play on.</h3><p>Track your reservation status, enjoy your session and share a review after your completed booking.</p><a href="@Url.Action("Index", "Reviews")">Community reviews &rarr;</a></article>
</section>
<section class="community-banner"><div><h3>A more active community starts with you.</h3><p>Need a hand finding the right space? Get in touch with the Sports Council.</p></div><a class="btn btn-lime" href="@Url.Action("Create", "Inquiries")">Talk to us &rarr;</a></section>
