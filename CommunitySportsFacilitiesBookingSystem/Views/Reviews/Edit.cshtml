@model CommunitySportsFacilitiesBookingSystem.Models.Review
@{ ViewBag.Title = "Moderate review"; }
<section class="surface"><div class="eyebrow">Community reviews</div><h2>@Model.ReviewTitle</h2><p>@Model.ReviewComment</p><p>Overall rating: @Model.OverallRating / 5</p>
@using (Html.BeginForm()) { @Html.AntiForgeryToken() @Html.HiddenFor(m => m.ReviewID)<div class="form-group"><label>@Html.CheckBoxFor(m => m.IsApproved) Visible to the community</label></div><button type="submit" class="btn btn-primary">Save visibility</button> <a class="btn btn-default" href="@Url.Action("Index")">Back to reviews</a> }
</section>
